# --- Servidor ---
# Puerto HTTP (Hostinger suele inyectarlo solo).
PORT=3000
# Cantidad de proxies delante de Node (Hostinger = 1). Verificar con DIAGNOSTICO=1.
TRUST_PROXY=1
# 1 habilita GET /api/diagnostico (solo para verificar el proxy; volver a 0 después).
DIAGNOSTICO=0

# --- Base de datos MySQL ---
# Host de MySQL (en Hostinger suele ser localhost).
DB_HOST=localhost
# Puerto de MySQL.
DB_PORT=3306
# Usuario de la base.
DB_USER=usuario_mysql
# Contraseña del usuario de la base.
DB_PASSWORD=cambiar
# Nombre de la base.
DB_NAME=nombre_base

# --- Sesión y CORS ---
# Secreto para firmar la cookie de sesión (mínimo 32 caracteres aleatorios).
SESSION_SECRET=cambiar-por-una-cadena-aleatoria-de-32-o-mas-caracteres
# URL pública del frontend (se usa en los links de los e-mails).
APP_URL=https://inventario.chacalo.com.ar
# Orígenes del frontend permitidos, separados por coma.
CORS_ORIGINS=https://inventario.chacalo.com.ar,https://beta-inventario.chacalo.com.ar
# Dominio de la cookie; dejar vacío = solo el host de la API. Ej.: .chacalo.com.ar
COOKIE_DOMAIN=

# --- Correo (SMTP) ---
# Servidor SMTP.
SMTP_HOST=smtp.example.com
# Puerto SMTP (465 = TLS directo).
SMTP_PORT=465
# Usuario SMTP.
SMTP_USER=usuario@example.com
# Contraseña SMTP.
SMTP_PASS=cambiar
# Nombre del remitente (opcional).
SMTP_FROM_NAME=Sistema IT de ST. Luke´s
# Dirección del remitente.
SMTP_FROM_EMAIL=inventario@example.com

# --- Scripts de migración (scripts/migrar.js y scripts/verificar.js) ---
# Solo se usan una vez, en el cutover desde Supabase; no hacen falta para el servidor.
# URL de Postgres de Supabase (usar el host del pooler de sesión, IPv4).
# PG_URL=postgresql://usuario:clave@aws-0-region.pooler.supabase.com:5432/postgres
# URL de MySQL de destino.
# MYSQL_URL=mysql://usuario:clave@host:3306/nombre_base
